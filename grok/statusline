#!/usr/bin/env python3
"""Grok status line in the tmux pipes register.

Same chrome as Claude. Grok already deducts padding from COLUMNS, so no
gutter. Live window is context_tokens; billed session is session_*.
Tank goes amber at auto_compact_threshold_percent (80 if omitted).
Cache is session hit% (cache_read / session_input), same idea as Claude.
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import unicodedata
from dataclasses import dataclass

# Catppuccin mocha + holon, same as ~/.tmux.conf
MAUVE = "#cba6f7"
LAVENDER = "#b4befe"
TEXT = "#cdd6f4"
OVERLAY0 = "#6c7086"
SURFACE1 = "#45475a"
GREEN = "#a6e3a1"
YELLOW = "#f9e2af"
RED = "#f38ba8"
BLUE = "#89b4fa"
FLAMINGO = "#f2cdcd"
PEACH = "#fab387"
TEAL = "#94e2d5"
SKY = "#89dceb"

SEP_CH = "┃"
BOLD = "\033[1m"
RESET = "\033[0m"
ANSI = re.compile(r"\x1b\[[0-9;:]*[A-Za-z]|\x1b\]8;;[^\x07\x1b]*(?:\x07|\x1b\\)")
# 2x4 braille tank. Empty cells are dim ⣿. Used cells climb the left
# column (⡀⡄⡆⡇) with the right column dark, then the right (⣇⣧⣷⣿).
# Right's first dot does not land until left is full.
FILL = ("⡀", "⡄", "⡆", "⡇", "⣇", "⣧", "⣷", "⣿")

# Grok sets COLUMNS to the row, padding already deducted.
GUTTER = 0
MIN_GAP = 1

# Nerd Mono, same catalog as ~/work/tmux-bar-gallery
ICO_DIR = "󰷏"
ICO_MODEL = "󰧑"  # was 󰫤 four-point star; see tmux-bar-gallery/claude-status.html
ICO_GIT = "󰘬"
ICO_OUT = ""
ICO_CACHE = "󰃨"
ICO_CLOCK = ""
ICO_EFFORT = "󱌼"
ICO_RATE = "󰓅"
ICO_WEEK = "󰃭"


def rgb(hex_color: str) -> str:
    h = hex_color.lstrip("#")
    r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
    return f"\033[38;2;{r};{g};{b}m"


SEP = f"{rgb(SURFACE1)}{SEP_CH}{RESET}"


def vislen(s: str) -> int:
    n = 0
    for ch in ANSI.sub("", s):
        if unicodedata.combining(ch):
            continue
        n += 2 if unicodedata.east_asian_width(ch) in ("F", "W") else 1
    return n


def paint(text: str, color: str, bold: bool = False) -> str:
    return f"{rgb(color)}{BOLD if bold else ''}{text}{RESET}"


def fmt_tokens(n: object) -> str:
    try:
        n = int(n or 0)
    except (TypeError, ValueError):
        return "?"
    if n < 1000:
        return str(n)
    if n < 1_000_000:
        x = n / 1000
        return f"{x:.1f}k" if x < 100 and not x.is_integer() else f"{x:.0f}k"
    x = n / 1_000_000
    return f"{x:.1f}M" if not x.is_integer() else f"{x:.0f}M"


def fmt_cost(usd: object, compact: bool = False) -> str | None:
    try:
        usd = float(usd)
    except (TypeError, ValueError):
        return None
    if usd < 0.005:
        return None
    if compact:
        if usd >= 1000:
            x = usd / 1000
            return f"${x:.1f}k" if x < 100 and not (x * 10).is_integer() else f"${x:.0f}k"
        if usd >= 100:
            return f"${usd:.0f}"
        if usd < 0.1:
            return f"${usd:.3f}"
        return f"${usd:.2f}"
    if usd < 0.1:
        return f"${usd:.3f}"
    return f"${usd:.2f}"


def fmt_duration(ms: object, compact: bool = False) -> str | None:
    try:
        sec = int(ms or 0) // 1000
    except (TypeError, ValueError):
        return None
    if sec < 1:
        return None
    if sec < 60:
        return f"{sec}s"
    mins = sec // 60
    if mins < 60:
        return f"{mins}m"
    hours, mins = divmod(mins, 60)
    days, hours_in = divmod(hours, 24)
    if compact:
        if days:
            return f"{days}d"
        return f"{hours}h"
    if days:
        return f"{days}d{hours_in:02d}h"
    return f"{hours}h{mins:02d}m"


def as_int(n: object) -> int | None:
    if n is None:
        return None
    try:
        return int(float(n))
    except (TypeError, ValueError):
        return None


def ctx_color(pct: int, compact_at: int | None = None) -> str:
    if pct >= 90:
        return RED
    warn = 80 if compact_at is None else compact_at
    if pct >= warn:
        return YELLOW
    return GREEN


def rate_color(pct: int, cool: str) -> str:
    if pct >= 90:
        return RED
    if pct >= 80:
        return YELLOW
    return cool


def rate_pct(limits: object, key: str) -> int | None:
    raw = ((limits or {}).get(key) or {}).get("used_percentage")
    if raw is None:
        return None
    try:
        return int(float(raw))
    except (TypeError, ValueError):
        return None


def ctx_bar(pct: int, width: int = 8, used: str = GREEN, empty: str = OVERLAY0) -> str:
    n = len(FILL)
    units = max(0, min(width * n, int(pct * width * n / 100)))
    if pct > 0 and units == 0:
        units = 1
    on = rgb(used)
    off = rgb(empty)
    out = []
    for i in range(width):
        u = units - i * n
        if u <= 0:
            out.append(f"{off}⣿{RESET}")
        elif u >= n:
            out.append(f"{on}⣿{RESET}")
        else:
            out.append(f"{on}{FILL[u - 1]}{RESET}")
    return "".join(out)


def git_branch(cwd: str) -> str | None:
    if not cwd:
        return None
    try:
        proc = subprocess.run(
            ["git", "rev-parse", "--abbrev-ref", "HEAD"],
            cwd=cwd,
            capture_output=True,
            text=True,
            timeout=0.2,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if proc.returncode != 0:
        return None
    branch = proc.stdout.strip()
    if not branch or branch == "HEAD":
        return None
    return branch


def join_left(parts: list[str]) -> str:
    if not parts:
        return ""
    return SEP.join(f" {p} " for p in parts) + SEP


def join_right(parts: list[str]) -> str:
    if not parts:
        return ""
    return "".join(SEP + f" {p} " for p in parts)


@dataclass
class Cell:
    key: str
    side: str
    priority: int
    full: str
    compact: str | None = None
    mode: str = "full"  # full | compact | gone

    def text(self) -> str:
        if self.mode == "compact" and self.compact:
            return self.compact
        return self.full


def _parts(cells: list[Cell], side: str) -> list[str]:
    return [c.text() for c in cells if c.side == side and c.mode != "gone"]


def _widths(cells: list[Cell]) -> tuple[int, int, int]:
    left = join_left(_parts(cells, "left"))
    right = join_right(_parts(cells, "right"))
    lw, rw = vislen(left), vislen(right)
    return lw, rw, lw + rw + MIN_GAP


def layout(cells: list[Cell], cols: int) -> str:
    """Fit whole cells into COLUMNS minus gutter. Compact, then drop, never chop.

    Stats are center-aligned on the row. If true-center would overlap identity,
    they sit just after the left cluster instead of colliding.
    """
    budget = max(20, cols - GUTTER)

    def overflow() -> bool:
        return _widths(cells)[2] > budget

    while overflow():
        shrinkable = [
            c
            for c in cells
            if c.mode == "full" and c.compact and c.compact != c.full
        ]
        if shrinkable:
            min(shrinkable, key=lambda c: c.priority).mode = "compact"
            continue
        live_right = [c for c in cells if c.side == "right" and c.mode != "gone"]
        if len(live_right) > 1:
            min(live_right, key=lambda c: c.priority).mode = "gone"
            continue
        live_left = [
            c
            for c in cells
            if c.side == "left" and c.mode != "gone" and c.key != "model"
        ]
        if live_left:
            min(live_left, key=lambda c: c.priority).mode = "gone"
            continue
        break

    left = join_left(_parts(cells, "left"))
    mid = join_right(_parts(cells, "right"))
    lw, mw = vislen(left), vislen(mid)
    if not mid:
        return left
    start = (budget - mw) // 2
    min_start = lw + (MIN_GAP if lw else 0)
    if start < min_start:
        start = min_start
    gap_l = max(0, start - lw)
    gap_r = max(0, budget - start - mw)
    return left + (" " * gap_l) + mid + (" " * gap_r)


def main() -> None:
    raw = sys.stdin.read()
    try:
        data = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        data = {}

    cols = 80
    try:
        cols = max(20, int(os.environ.get("COLUMNS") or 80))
    except ValueError:
        pass

    model = ((data.get("model") or {}).get("display_name")) or "grok"
    cwd = (data.get("workspace") or {}).get("current_dir") or data.get("cwd") or ""
    folder = cwd.rstrip("/").rsplit("/", 1)[-1] if cwd else ""
    cw = data.get("context_window") or {}
    used = as_int(cw.get("context_tokens") or cw.get("total_input_tokens")) or 0
    out_tok = as_int(cw.get("session_output_tokens") or cw.get("total_output_tokens")) or 0
    size = as_int(cw.get("context_window_size")) or 0
    pct = cw.get("used_percentage")
    if pct is None and size:
        pct = 100.0 * float(used) / float(size)
    pct_i = as_int(pct) or 0
    compact_at = as_int(cw.get("auto_compact_threshold_percent"))
    color = ctx_color(pct_i, compact_at)
    cost = data.get("cost") or {}
    usd = cost.get("total_cost_usd")
    dur_ms = cost.get("total_duration_ms")
    added, removed = 0, 0
    su = cw.get("session_usage") or {}
    sess_in = as_int(cw.get("session_input_tokens")) or 0
    cache_read = as_int(su.get("cache_read_input_tokens"))
    effort = ((data.get("effort") or {}).get("level") or "").strip()
    limits = data.get("rate_limits") or {}
    five = rate_pct(limits, "five_hour")
    week = rate_pct(limits, "seven_day")
    branch = git_branch(cwd)

    cells: list[Cell] = []
    if folder:
        cells.append(
            Cell("folder", "left", 80, f"{paint(ICO_DIR, MAUVE)} {paint(folder, TEXT, bold=True)}")
        )
    cells.append(
        Cell("model", "left", 100, f"{paint(ICO_MODEL, LAVENDER)} {paint(model, LAVENDER)}")
    )
    if branch:
        cells.append(
            Cell("git", "left", 40, f"{paint(ICO_GIT, OVERLAY0)} {paint(branch, OVERLAY0)}")
        )

    if size:
        nums = paint(f"{fmt_tokens(used)}/{fmt_tokens(size)} {pct_i}%", color)
        billed = paint(f"· {fmt_tokens(sess_in)}", OVERLAY0) if sess_in else ""
        meter_full = f"{ctx_bar(pct_i, 8, used=color)} {nums}"
        if billed:
            meter_full = f"{meter_full} {billed}"
        meter_compact = f"{ctx_bar(pct_i, 4, used=color)} {nums}"
        cells.append(Cell("meter", "right", 100, meter_full, meter_compact))
    else:
        cells.append(Cell("meter", "right", 100, paint(f"{fmt_tokens(used)} in", OVERLAY0)))
    if sess_in and cache_read is not None:
        hit = int(round(100.0 * cache_read / sess_in))
        cache_color = GREEN if hit >= 70 else YELLOW
        label = f"{hit}%"
        cells.append(
            Cell(
                "cache",
                "right",
                76,
                f"{paint(ICO_CACHE, cache_color)} {paint(label, cache_color)}",
                paint(label, cache_color),
            )
        )
    if out_tok:
        cells.append(
            Cell("out", "right", 70, f"{paint(ICO_OUT, BLUE)} {paint(fmt_tokens(out_tok), BLUE)}")
        )
    if added or removed:
        lines_full = f"{paint(f'+{added}', GREEN)} {paint(f'-{removed}', RED)}"
        lines_compact = paint(f"+{added}/-{removed}", GREEN if added >= removed else RED)
        cells.append(Cell("lines", "right", 66, lines_full, lines_compact))
    cost_full, cost_compact = fmt_cost(usd), fmt_cost(usd, compact=True)
    if cost_full:
        cells.append(
            Cell("cost", "right", 80, paint(cost_full, FLAMINGO), paint(cost_compact or cost_full, FLAMINGO))
        )
    clock_full, clock_compact = fmt_duration(dur_ms), fmt_duration(dur_ms, compact=True)
    if clock_full:
        cells.append(
            Cell(
                "clock",
                "right",
                60,
                f"{paint(ICO_CLOCK, OVERLAY0)} {paint(clock_full, OVERLAY0)}",
                f"{paint(ICO_CLOCK, OVERLAY0)} {paint(clock_compact or clock_full, OVERLAY0)}",
            )
        )
    if effort:
        cells.append(
            Cell("effort", "right", 50, f"{paint(ICO_EFFORT, TEAL)} {paint(effort, TEAL)}")
        )
    if five is not None:
        five_c = rate_color(five, PEACH)
        cells.append(
            Cell(
                "rate5h",
                "right",
                42,
                f"{paint(ICO_RATE, five_c)} {paint(f'5h {five}%', five_c)}",
                paint(f"5h {five}%", five_c),
            )
        )
    if week is not None:
        week_c = rate_color(week, SKY)
        cells.append(
            Cell(
                "rate7d",
                "right",
                35,
                f"{paint(ICO_WEEK, week_c)} {paint(f'7d {week}%', week_c)}",
                paint(f"7d {week}%", week_c),
            )
        )

    print(layout(cells, cols))


if __name__ == "__main__":
    main()
